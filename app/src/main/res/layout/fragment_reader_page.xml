<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/darkest">
    <com.nkanaev.comics.view.InterceptTouchLayout
            android:id="@+id/touchInterceptor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
        <com.nkanaev.comics.view.PageImageView
                android:id="@+id/pageImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
    </com.nkanaev.comics.view.InterceptTouchLayout>
    <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
        <ImageButton
                android:id="@+id/errorButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:src="@drawable/broken"/>
        <include layout="@layout/progress_image"/>
    </RelativeLayout>
</FrameLayout>